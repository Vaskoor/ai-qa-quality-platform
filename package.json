{
  "name": "ai-qa-quality-platform",
  "version": "1.0.0",
  "description": "AI-Powered QA Quality Platform - AI test generation + integrated UI/API/contract/visual/perf/security testing with observability",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:tests": "tsx src/ai-generator/cli.ts",
    "inspect:spec": "tsx src/ai-generator/cli.ts inspect",
    "test:api": "playwright test --project=api",
    "test:generated": "playwright test --project=generated",
    "test:ui": "playwright test --project=ui",
    "test:contract": "playwright test --project=contract",
    "test:visual": "playwright test --project=visual",
    "test:all": "playwright test",
    "test:perf": "k6 run perf/load-test.js",
    "test:security": "bash scripts/run-zap.sh",
    "qa:full": "bash scripts/run-full-qa.sh",
    "observability:up": "docker compose -f observability/docker-compose.yml up -d",
    "observability:down": "docker compose -f observability/docker-compose.yml down",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "demo:server": "tsx src/api/server.ts"
  },
  "keywords": [
    "qa",
    "ai",
    "playwright",
    "testing",
    "openapi",
    "k6",
    "zap",
    "observability",
    "prometheus",
    "grafana"
  ],
  "author": "Bhaskar Kaphle",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "ajv": "^8.17.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
