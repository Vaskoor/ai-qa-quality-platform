# ============================================================
# AI-Powered QA Quality Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file.

# --- LLM Provider (for AI test generation) ---
# Use OpenAI, or any OpenAI-compatible endpoint (Azure, Ollama, OpenRouter, etc.)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# If true, uses a deterministic offline generator (no API key needed)
QA_USE_MOCK_LLM=false

# --- Target API under test ---
API_BASE_URL=http://localhost:3000
OPENAPI_SPEC_PATH=./specs/petstore-openapi.json

# --- Test tuning ---
QA_MAX_CASES_PER_ENDPOINT=6
QA_OUTPUT_DIR=./tests/generated
LOG_LEVEL=info

# --- Security scanning (OWASP ZAP) ---
ZAP_TARGET_URL=http://localhost:3000
ZAP_API_KEY=change-me

# --- Performance (k6) ---
K6_BASE_URL=http://localhost:3000
K6_VUS=10
K6_DURATION=30s

# --- Observability ---
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001