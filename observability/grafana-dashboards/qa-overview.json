{
  "title": "QA Platform — API Overview",
  "uid": "qa-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(qa_demo_http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(qa_demo_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total requests",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(qa_demo_http_requests_total)" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate (5xx)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(qa_demo_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(qa_demo_http_requests_total[5m])), 1)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Process uptime (s)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "process_uptime_seconds" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Status code breakdown",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(qa_demo_http_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}